{
  "name": "dsh-database-explorer",
  "version": "0.1.0",
  "description": "Database explorer for DeepSeek Harness: connect SQLite / MySQL / PostgreSQL / SQL Server / MongoDB / ClickHouse, browse schemas and run SQL — a PyCharm-Database-style panel as a third Conversation tab. Cell editing, auto-reconnect and full-table browsing included.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "database",
    "sql",
    "mysql",
    "postgres",
    "sqlite",
    "mongodb",
    "clickhouse",
    "mssql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xing-he888/dsh-database-explorer.git"
  },
  "homepage": "https://github.com/xing-he888/dsh-database-explorer#readme",
  "bugs": "https://github.com/xing-he888/dsh-database-explorer/issues",
  "author": "xing-he888",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": false
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "optionalDependencies": {
    "@clickhouse/client": "^1.23.1",
    "mssql": "^12.7.2",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT"
}
